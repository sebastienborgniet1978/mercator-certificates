# --- Mercator (API REST) ---
# URL de base de Mercator, sans /api (ex. http://mercator.bpp.local ou http://host:8081)
MERCATOR_URL=http://mercator.bpp.local
# Compte de service Mercator : rôle en lecture seule avec "certificate_access"
# (+ logical_server_access et application_access pour afficher les noms liés)
MERCATOR_LOGIN=svc-certs@example.com
MERCATOR_PASSWORD=changeme
# false si Mercator est en HTTPS avec un certificat interne non reconnu par le conteneur
MERCATOR_VERIFY_TLS=true
# URL de Mercator ACCESSIBLE DEPUIS LE NAVIGATEUR des utilisateurs : active les liens
# « Renouveler » (écran d'édition du certificat) et « Voir la fiche » dans Mercator
MERCATOR_PUBLIC_URL=http://mercator.bpp.local

# --- App ---
CACHE_TTL=300
CRITICAL_DAYS=30
WARNING_DAYS=90
# Mots-clés (séparés par des virgules) repérant une LICENCE dans la colonne « type » de Mercator
LICENSE_TYPE_KEYWORDS=licen
# Fuseau horaire affiché dans les rapports
REPORT_TZ=Europe/Luxembourg
# Mots-clés repérant un NOM DE DOMAINE dans la colonne « type »
DOMAIN_TYPE_KEYWORDS=domain,dns
APP_TITLE=Certificats – Mercator
# HTTP Basic optionnel (laisser vide si l'accès est protégé en amont)
APP_BASIC_USER=
APP_BASIC_PASSWORD=
